{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "berliner-maps-links",
  "main": "worker.ts",
  "compatibility_date": "2026-11-26",
  "workers_dev": true,
  "vars": { "ALLOWED_ORIGINS": "https://thanu8848.github.io" },
  "ratelimits": [{ "name": "LINK_LIMITER", "namespace_id": "1001", "simple": { "limit": 30, "period": 60 } }],
  "observability": { "enabled": false }
}
